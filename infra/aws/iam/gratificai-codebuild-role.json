{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloneCompletoDoGitHub",
      "Effect": "Allow",
      "Action": [
        "codeconnections:UseConnection",
        "codeconnections:GetConnection",
        "codeconnections:GetConnectionToken",
        "codestar-connections:UseConnection",
        "codestar-connections:GetConnection",
        "codestar-connections:GetConnectionToken"
      ],
      "Resource": "<ARN-DA-CONEXAO>"
    },
    {
      "Sid": "LogsDosProjetos",
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": [
        "arn:aws:logs:us-east-1:<CONTA>:log-group:/aws/codebuild/gratificai-*",
        "arn:aws:logs:us-east-1:<CONTA>:log-group:/aws/codebuild/gratificai-*:*"
      ]
    },
    {
      "Sid": "ArtefatosDoPipeline",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:GetObjectVersion", "s3:PutObject", "s3:GetBucketAcl", "s3:GetBucketLocation"],
      "Resource": ["arn:aws:s3:::codepipeline-us-east-1-*", "arn:aws:s3:::codepipeline-us-east-1-*/*"]
    },
    {
      "Sid": "RelatoriosDeTeste",
      "Effect": "Allow",
      "Action": [
        "codebuild:CreateReportGroup",
        "codebuild:CreateReport",
        "codebuild:UpdateReport",
        "codebuild:BatchPutTestCases",
        "codebuild:BatchPutCodeCoverages"
      ],
      "Resource": "arn:aws:codebuild:us-east-1:<CONTA>:report-group/gratificai-*"
    },
    {
      "Sid": "LoginNoEcr",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "PushSoNosRepositoriosDoProjeto",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:BatchGetImage",
        "ecr:CompleteLayerUpload",
        "ecr:InitiateLayerUpload",
        "ecr:PutImage",
        "ecr:UploadLayerPart"
      ],
      "Resource": [
        "arn:aws:ecr:us-east-1:<CONTA>:repository/gratificai-api",
        "arn:aws:ecr:us-east-1:<CONTA>:repository/gratificai-web"
      ]
    }
  ]
}
