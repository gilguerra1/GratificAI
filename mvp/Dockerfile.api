FROM public.ecr.aws/docker/library/node:24-bookworm-slim

ENV NODE_ENV=production \
    API_HOST=0.0.0.0 \
    API_PORT=3001

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force

COPY server/app.mjs server/index.mjs server/bootstrap.mjs server/database.mjs server/migrate-sqlite.mjs ./server/
COPY src/domain.ts src/ml.ts ./src/

USER node

EXPOSE 3001
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 CMD ["node", "-e", "fetch('http://127.0.0.1:3001/api/health').then(response => process.exit(response.ok ? 0 : 1)).catch(() => process.exit(1))"]

CMD ["node", "server/index.mjs"]
