{
  "family": "gratificai",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "runtimePlatform": { "operatingSystemFamily": "LINUX", "cpuArchitecture": "X86_64" },
  "executionRoleArn": "arn:aws:iam::<CONTA>:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "api",
      "image": "<URI-ECR-API>:<TAG>",
      "essential": true,
      "portMappings": [{ "containerPort": 3001, "protocol": "tcp" }],
      "environment": [
        { "name": "NODE_ENV", "value": "production" },
        { "name": "APP_ORIGIN", "value": "https://<SEU-DOMINIO>.cloudfront.net" },
        { "name": "API_HOST", "value": "0.0.0.0" },
        { "name": "API_PORT", "value": "3001" },
        { "name": "PGHOST", "value": "<ENDPOINT-DO-RDS>" },
        { "name": "PGPORT", "value": "5432" },
        { "name": "PGDATABASE", "value": "gratificai" },
        { "name": "PGUSER", "value": "gratificai" },
        { "name": "PGSSLMODE", "value": "no-verify" },
        { "name": "NODE_OPTIONS", "value": "--import @opentelemetry/auto-instrumentations-node/register" },
        { "name": "OTEL_SERVICE_NAME", "value": "gratificai-api" },
        { "name": "OTEL_EXPORTER_OTLP_ENDPOINT", "value": "http://<IP-PRIVADO-DA-EC2>:4318" },
        { "name": "OTEL_EXPORTER_OTLP_PROTOCOL", "value": "http/protobuf" },
        { "name": "OTEL_TRACES_EXPORTER", "value": "otlp" },
        { "name": "OTEL_METRICS_EXPORTER", "value": "otlp" },
        { "name": "OTEL_LOGS_EXPORTER", "value": "none" },
        { "name": "OTEL_NODE_DISABLED_INSTRUMENTATIONS", "value": "fs,dns,net" }
      ],
      "secrets": [
        { "name": "PGPASSWORD", "valueFrom": "<ARN-DO-SEGREDO-DO-RDS>:password::" }
      ],
      "healthCheck": {
        "command": ["CMD", "node", "-e", "fetch('http://127.0.0.1:3001/api/health').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"],
        "interval": 30, "timeout": 5, "retries": 3, "startPeriod": 30
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/gratificai",
          "awslogs-create-group": "true",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "api"
        }
      }
    },
    {
      "name": "web",
      "image": "<URI-ECR-WEB>:<TAG>",
      "essential": true,
      "portMappings": [{ "containerPort": 8080, "protocol": "tcp" }],
      "dependsOn": [{ "containerName": "api", "condition": "HEALTHY" }],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/gratificai",
          "awslogs-create-group": "true",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "web"
        }
      }
    }
  ]
}
