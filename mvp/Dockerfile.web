FROM public.ecr.aws/docker/library/node:24-bookworm-slim AS build

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM public.ecr.aws/docker/library/nginx:stable-alpine

# nginx.default.conf (Compose) ou nginx.ecs.conf (ECS), escolhido no build.
ARG NGINX_SITE_CONF=nginx.default.conf

COPY nginx.conf /etc/nginx/nginx.conf
COPY ${NGINX_SITE_CONF} /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

USER 101:101
EXPOSE 8080
